<%# VIEW: listagem de produtos. Recebe { produtos }. Mostre uma tabela com nome, preço e o NOME DA CATEGORIA de cada
  produto (o nome da categoria vem do relacionamento — garanta que o repositório trouxe a categoria junto). Inclua
  também um link para cadastrar um novo produto. %>
  <!-- TODO: link "Novo Produto" e a tabela (com a coluna Categoria) -->

  <h2>Produtos</h2> <a href="/produtos/novo">Novo Produto</a>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Categoria</th>
      </tr>
    </thead>
    <tbody>
      <% produtos.forEach(p=> { %> <tr>
          <td>
            <%= p.nome %>
          </td>
          <td>R$ <%= p.preco.toFixed(2) %>
          </td>
          <td>
            <%= p.categoria ? p.categoria.nome : '' %>
          </td>
        </tr>
        <% }) %>
    </tbody>
  </table>