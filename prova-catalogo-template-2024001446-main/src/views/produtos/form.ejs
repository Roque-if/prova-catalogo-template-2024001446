<%# VIEW: formulário de produto. Recebe { titulo, valores, categorias, erros }. Monte um <form method="POST"
  action="/produtos"> com:
  - nome (texto, obrigatório);
  - preço (número, obrigatório);
  - categoria: um <select name="categoriaId"> com uma <option> para cada item de
      `categorias` (é aqui que o relacionamento aparece na tela).
      Reexiba `valores` e mostre a lista de `erros` quando houver.
      %>
      <h2>Novo Produto</h2>
      <% if (erro) { %>
        <p class="erro">
          <%= erro %>
        </p>
        <% } %>
          <form action="/produtos" method="POST"> <input type="text" name="nome" placeholder="Nome" required /> <input
              type="number" step="0.01" name="preco" placeholder="Preço" required /> <select name="categoriaId"
              required>
              <option value="">Selecione uma categoria</option>
              <% categorias.forEach(c=> { %> <option value="<%= c.id %>">
                  <%= c.nome %>
                </option>
                <% }) %>
            </select> <button type="submit">Salvar</button> </form>

          <!-- TODO: bloco de erros + formulário com nome, preço e o <select> de categoria -->